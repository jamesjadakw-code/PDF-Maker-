    <script>
        let uploadedImages = [
            '%2339304%20-%202015%20Ditch%20Witch%20RT120%20Quad%20listed%20with%20HDD%20Broker_files/39304--ecd1ebad-109a-403f-8641-d0ec037dcc39.jpg',
            '%2339304%20-%202015%20Ditch%20Witch%20RT120%20Quad%20listed%20with%20HDD%20Broker_files/39304--0810d70a-d39e-487a-ae8e-c9adbe410d9b.jpg',
            '%2339304%20-%202015%20Ditch%20Witch%20RT120%20Quad%20listed%20with%20HDD%20Broker_files/39304--0be8f3bb-1cf1-4460-ba45-8ee1cca3321b.jpg',
            '%2339304%20-%202015%20Ditch%20Witch%20RT120%20Quad%20listed%20with%20HDD%20Broker_files/39304--155dd132-f7e6-44ec-bb55-226a07884313.jpg'
        ];

        function setHero(index) {
            const item = uploadedImages.splice(index, 1)[0];
            uploadedImages.unshift(item);
            renderGalleries();
        }

        function deleteImage(index) {
            if (uploadedImages.length <= 1) { alert("You must keep at least one image."); return; }
            uploadedImages.splice(index, 1);
            renderGalleries();
        }

        function renderGalleries() {
            const sidebar = document.getElementById('sidebarGallery');
            const sheet = document.getElementById('sheetGallery');
            sidebar.innerHTML = "";
            sheet.innerHTML = "";

            uploadedImages.forEach((img, idx) => {
                const sideItem = document.createElement('div');
                sideItem.className = "relative group aspect-square bg-zinc-800 rounded border border-zinc-700 overflow-hidden hover:border-amber-400 transition cursor-pointer";
                sideItem.onclick = () => setHero(idx);
                sideItem.innerHTML = `<img src="${img}" class="w-full h-full object-cover"><button onclick="event.stopPropagation(); deleteImage(${idx})" class="absolute top-0 right-0 bg-red-600 text-white p-1 opacity-0 group-hover:opacity-100 transition"><svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg></button>`;
                sidebar.appendChild(sideItem);

                if (idx > 0) {
                    const sheetItem = document.createElement('div');
                    sheetItem.className = "aspect-square bg-gray-100 rounded-lg border-2 border-gray-100 overflow-hidden shadow-sm hover:border-amber-400 transition cursor-pointer";
                    sheetItem.onclick = () => setHero(idx);
                    sheetItem.innerHTML = `<img src="${img}" class="w-full h-full object-cover">`;
                    sheet.appendChild(sheetItem);
                }
            });
            document.getElementById('sheetImage').src = uploadedImages[0];
        }

        async function handleManualUpload(evt) {
            const files = Array.from(evt.target.files);
            if (!files.length) return;
            logStatus(`Processing ${files.length} images...`);
            const promises = files.map(file => new Promise(resolve => {
                const reader = new FileReader();
                reader.onload = e => resolve(e.target.result);
                reader.readAsDataURL(file);
            }));
            const results = await Promise.all(promises);
            uploadedImages = [...results, ...uploadedImages];
            renderGalleries();
            logStatus("Upload Complete", false);
            setTimeout(() => document.getElementById('statusBox').classList.add('hidden'), 2000);
        }

        function updateSheet() {
            // General
            document.getElementById('sheetName').innerText = document.getElementById('inName').value;
            document.getElementById('sheetPrice').innerText = '$' + document.getElementById('inPrice').value;
            document.getElementById('sheetStock').innerText = document.getElementById('inStock').value;
            document.getElementById('sheetDesc').innerText = document.getElementById('inDesc').value;
            document.getElementById('sheetAgentDisplay').innerText = document.getElementById('inAgent').value.split('•')[0].trim();

            // Advantages
            document.getElementById('sheetFeat1').innerText = document.getElementById('inFeat1').value;
            document.getElementById('sheetFeat2').innerText = document.getElementById('inFeat2').value;
            document.getElementById('sheetFeat3').innerText = document.getElementById('inFeat3').value;
            document.getElementById('sheetFeat4').innerText = document.getElementById('inFeat4').value;

            // Specs
            document.getElementById('sheetSpecL1').innerText = document.getElementById('inSpecL1').value;
            document.getElementById('sheetSpecV1').innerText = document.getElementById('inSpecV1').value;
            document.getElementById('sheetSpecL2').innerText = document.getElementById('inSpecL2').value;
            document.getElementById('sheetSpecV2').innerText = document.getElementById('inSpecV2').value;
            document.getElementById('sheetSpecL3').innerText = document.getElementById('inSpecL3').value;
            document.getElementById('sheetSpecV3').innerText = document.getElementById('inSpecV3').value;
            document.getElementById('sheetSpecL4').innerText = document.getElementById('inSpecL4').value;
            document.getElementById('sheetSpecV4').innerText = document.getElementById('inSpecV4').value;
        }

        function showPrintAssistant() { document.getElementById('printAssistant').classList.remove('hidden'); }
        function triggerFinalPrint() { document.getElementById('printAssistant').classList.add('hidden'); window.focus(); window.print(); }

        function logStatus(text, showSpinner = true) {
            const box = document.getElementById('statusBox');
            const label = document.getElementById('statusText');
            box.classList.remove('hidden');
            label.innerText = text;
            box.querySelector('.spinner').style.display = showSpinner ? 'block' : 'none';
        }

        async function exportPDFWithPicker() {
            const btn = document.getElementById('pdfBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = `<span class="spinner"></span> Working...`;
            btn.disabled = true;
            logStatus("Capturing Sheet Content...");
            const element = document.getElementById('sheet');
            const filename = `BMT_Sheet_${document.getElementById('inStock').value}.pdf`;
            const opt = {
                margin: 0, filename: filename, image: { type: 'jpeg', quality: 1.0 },
                html2canvas: { scale: 2, useCORS: true, letterRendering: true, allowTaint: true },
                jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' }
            };

            try {
                logStatus("Building PDF Document...");
                const blob = await html2pdf().set(opt).from(element).toPdf().output('blob');
                if ('showSaveFilePicker' in window) {
                    logStatus("Waiting for folder selection...");
                    const handle = await window.showSaveFilePicker({ suggestedName: filename, types: [{ description: 'PDF Document', accept: { 'application/pdf': ['.pdf'] } }] });
                    const writable = await handle.createWritable();
                    await writable.write(blob);
                    await writable.close();
                    logStatus("File Saved Successfully!", false);
                } else {
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a'); a.href = url; a.download = filename;
                    document.body.appendChild(a); a.click();
                    logStatus("Saved to Downloads", false);
                }
            } catch (err) { logStatus("Export Blocked", false); } finally {
                btn.innerHTML = originalText; btn.disabled = false;
                setTimeout(() => document.getElementById('statusBox').classList.add('hidden'), 3000);
            }
        }

        renderGalleries();
    </script>
</body>
